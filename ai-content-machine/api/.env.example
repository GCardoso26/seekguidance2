AUTOMATION_MODE=mock
PORT=8787
CWM_DB_PATH=../data/cwm.sqlite
CWM_API_BASE=http://127.0.0.1:8787
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Phase 5 — controlled real publishing (defaults are SAFE)
DRY_RUN=true
PUBLISHING_ENABLED=false
YOUTUBE_PUBLISHING_ENABLED=false
GLOBAL_PUBLISHING_KILL_SWITCH=true
MAX_PUBLICATIONS_PER_DAY=1

# YouTube OAuth (never commit real values)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8787/api/publishing/connections/youtube/callback
CWM_CREDENTIALS_ENCRYPTION_KEY=

# Optional env-token fallback for local REAL_PROVIDER_E2E (prefer OAuth store)
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_EXPIRES_AT=

# Visual sources (optional — stock is the normal Shorts path)
PEXELS_API_KEY=
PIXABAY_API_KEY=
COMFY_BASE_URL=
GEMINI_API_KEY=
GROQ_API_KEY=
KOKORO_BASE_URL=
CWM_MUSIC_PATH=
CWM_SFX_PATH=
