# Copie para .env na raiz de ai-content-machine (NÃO committe .env)
# cp .env.oci.example .env

# --- Público (acesso por IP em HTTP — ajuste quando tiver domínio/HTTPS) ---
DOMAIN=
WEBHOOK_URL=http://164.152.28.87:5678/
CWM_PUBLIC_API_BASE=http://164.152.28.87:8787
VITE_CWM_API_BASE=http://164.152.28.87:8787
# ⚠️ Sem barra final e SEM /api no final.
# O front já chama `${VITE_CWM_API_BASE}/api/...`
# Errado: https://IP/api  → vira /api/api/... e HTTPS:443 recusado

# --- n8n (acesso direto :5678, SEM path /n8n) ---
N8N_HOST=164.152.28.87
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=
N8N_PATH=/
N8N_SECURE_COOKIE=false
N8N_USER=admin
N8N_PASSWORD=troque-esta-senha-forte
# Gere: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_API_KEY=
# Gere: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Senhas internas Docker (troque em produção)
POSTGRES_N8N_PASSWORD=troque-n8n-db-password
POSTGRES_CWM_PASSWORD=troque-cwm-db-password

# --- Control Plane ---
AUTOMATION_MODE=mock
PORT=8787
# production exige n8n configurado; mantenha mock até validar a stack

# Workspace default para crons n8n (Analytics Sync / Real Analytics / Winner)
# Ex.: 86e1e2c0-38a0-44cb-962f-2def3227f516
CWM_DEFAULT_WORKSPACE_ID=

# Assets de produção (vídeo/thumb) — no Docker Compose já aponta para /data/assets (volume)
# CWM_ASSETS_PATH=/data/assets

# Safety (Fase 5) — defaults seguros
DRY_RUN=true
PUBLISHING_ENABLED=false
YOUTUBE_PUBLISHING_ENABLED=false
GLOBAL_PUBLISHING_KILL_SWITCH=true
MAX_PUBLICATIONS_PER_DAY=1

# YouTube OAuth (só para Fase 5.1 real — nunca no git)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://seu-dominio.com/api/publishing/connections/youtube/callback
# Gere: openssl rand -base64 32
CWM_CREDENTIALS_ENCRYPTION_KEY=

# --- Ollama (host) — Script Factory FallbackScriptProvider ---
# Na API em Docker use host.docker.internal (compose já tem extra_hosts).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=120000

# --- Kokoro TTS (host) — FallbackVoiceProvider ---
# Mesmo padrão do Ollama: extra_hosts já no compose. Não expor :8880 no NSG/Security List da OCI.
KOKORO_BASE_URL=http://host.docker.internal:8880
KOKORO_VOICE=pf_dora
KOKORO_MODEL=kokoro
# KOKORO_API_KEY=

# --- ComfyUI — FallbackVisualProvider, só no MISS ---
# Não expor :8188 no NSG/Security List da OCI.
# Vazio = Mock nas imagens novas → pacote READY_FOR_REVIEW (NÃO publicável).
#
# A) A1 CPU (docker compose --profile comfy):
# COMFY_BASE_URL=http://comfy:8188
# COMFY_WORKFLOW=image_a1_cpu
# COMFY_CHECKPOINT=v1-5-pruned-emaonly.safetensors
# COMFY_WIDTH=512
# COMFY_HEIGHT=768
# COMFY_STEPS=4
#
# B) Ponte GPU no PC (ssh -R 8188:127.0.0.1:8188 ubuntu@VPS):
# COMFY_BASE_URL=http://host.docker.internal:8188
# COMFY_WORKFLOW=image_cinematic
#
# Ver docs/COMFYUI_A1_VS_PC.md
# COMFY_BASE_URL=
COMFY_WORKFLOW=image_a1_cpu
COMFY_TIMEOUT_MS=900000
COMFY_HTTP_TIMEOUT_MS=30000
COMFY_HEALTH_TIMEOUT_MS=5000
COMFY_POLL_MS=3000
# COMFY_CHECKPOINT=v1-5-pruned-emaonly.safetensors
