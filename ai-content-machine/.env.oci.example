# Copie para .env na raiz de ai-content-machine (NÃO committe .env)
# cp .env.oci.example .env

# --- Público ---
DOMAIN=seu-dominio.com
# Use http://IP_PUBLICO se ainda não tiver domínio
WEBHOOK_URL=https://seu-dominio.com/
CWM_PUBLIC_API_BASE=https://seu-dominio.com/api
VITE_CWM_API_BASE=https://seu-dominio.com/api

# --- n8n ---
N8N_HOST=seu-dominio.com
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://seu-dominio.com/n8n/
N8N_PATH=/n8n/
N8N_USER=admin
N8N_PASSWORD=troque-esta-senha-forte
# Gere: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_API_KEY=
# Gere: openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# Senhas internas Docker (troque em produção)
POSTGRES_N8N_PASSWORD=troque-n8n-db-password
POSTGRES_CWM_PASSWORD=troque-cwm-db-password

# --- Control Plane ---
AUTOMATION_MODE=mock
PORT=8787
# production exige n8n configurado; mantenha mock até validar a stack

# Safety (Fase 5) — defaults seguros
DRY_RUN=true
PUBLISHING_ENABLED=false
YOUTUBE_PUBLISHING_ENABLED=false
GLOBAL_PUBLISHING_KILL_SWITCH=true
MAX_PUBLICATIONS_PER_DAY=1

# YouTube OAuth (só para Fase 5.1 real — nunca no git)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://seu-dominio.com/api/publishing/connections/youtube/callback
# Gere: openssl rand -base64 32
CWM_CREDENTIALS_ENCRYPTION_KEY=
