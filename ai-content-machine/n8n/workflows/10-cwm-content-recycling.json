{
  "name": "CWM — Content Recycling Engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cwm/content-recycling",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.CWM_API_BASE}}/api/ai/prompts/content_recycler"
      },
      "id": "prompt",
      "name": "Load Recycler Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CWM_API_BASE}}/api/automation/trigger",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"content_recycling\",\n  \"workspaceId\": \"{{$('Webhook').item.json.body.workspaceId}}\",\n  \"payload\": {\n    \"contentId\": \"{{$('Webhook').item.json.body.contentId}}\"\n  }\n}"
      },
      "id": "trigger",
      "name": "Trigger Recycling",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Load Recycler Prompt", "type": "main", "index": 0 }]]
    },
    "Load Recycler Prompt": {
      "main": [[{ "node": "Trigger Recycling", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "cwm": {
      "workflowKey": "content_recycling",
      "version": 1,
      "purpose": "Winner → 10+ derivatives with parentContentId + newAngle/hook/script",
      "tables": ["content_ideas", "contents"]
    }
  }
}
