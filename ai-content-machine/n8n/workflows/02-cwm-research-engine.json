{
  "name": "CWM — Research Engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cwm/research-engine",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 6 * * *" }]
        }
      },
      "id": "cron",
      "name": "Cron Daily 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 520]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CWM_API_BASE}}/api/automation/trigger",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"research_engine\",\n  \"workspaceId\": \"{{$json.body.workspaceId || $env.CWM_DEFAULT_WORKSPACE_ID}}\",\n  \"payload\": { \"source\": \"n8n-research\" }\n}"
      },
      "id": "trigger",
      "name": "Trigger Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 400]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Trigger Research", "type": "main", "index": 0 }]]
    },
    "Cron Daily 06:00": {
      "main": [[{ "node": "Trigger Research", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "cwm": {
      "workflowKey": "research_engine",
      "version": 1,
      "purpose": "Research opportunities, persist topics/sources",
      "tables": ["topics", "niches", "domain_events"]
    }
  }
}
