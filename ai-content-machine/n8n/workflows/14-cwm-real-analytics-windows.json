{
  "name": "CWM — Real Analytics Windows",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 * * * *" }]
        }
      },
      "id": "cron",
      "name": "Hourly Windows",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cwm/real-analytics-windows",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CWM_API_BASE}}/api/analytics/sync",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const body = ($json && $json.body) ? $json.body : $json; const workspaceId = (body && body.workspaceId) || $env.CWM_DEFAULT_WORKSPACE_ID; const publicationId = body && body.publicationId; const out = { workspaceId, preferReal: true, await: true }; if (publicationId) out.publicationId = publicationId; return out; })() }}",
        "options": { "timeout": 180000 }
      },
      "id": "sync",
      "name": "Sync Real Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 390]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 480]
    }
  ],
  "connections": {
    "Hourly Windows": { "main": [[{ "node": "Sync Real Metrics", "type": "main", "index": 0 }]] },
    "Webhook": { "main": [[{ "node": "Sync Real Metrics", "type": "main", "index": 0 }]] },
    "Sync Real Metrics": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "cwm": {
      "workflowKey": "real_analytics_windows",
      "version": 2,
      "purpose": "Poll metrics windows (1h/6h/24h/48h/7d) for REAL publications without aggressive looping",
      "tables": ["metric_snapshots", "publication_runs"],
      "controlPlane": "/api/analytics/sync",
      "windows": ["1h", "6h", "24h", "48h", "7d"],
      "note": "Requires CWM_DEFAULT_WORKSPACE_ID on n8n+api. Cron omits publicationId when empty."
    }
  }
}
