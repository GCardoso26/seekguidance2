{
  "name": "CWM — Script Factory",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cwm/script-factory",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.CWM_API_BASE}}/api/ai/prompts/script_generator"
      },
      "id": "prompt",
      "name": "Load Script Prompt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CWM_API_BASE}}/api/automation/trigger",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"script_factory\",\n  \"workspaceId\": \"{{$('Webhook').item.json.body.workspaceId}}\",\n  \"payload\": {\n    \"contentIdeaId\": \"{{$('Webhook').item.json.body.contentIdeaId}}\"\n  }\n}"
      },
      "id": "trigger",
      "name": "Trigger Script Factory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Load Script Prompt", "type": "main", "index": 0 }]]
    },
    "Load Script Prompt": {
      "main": [[{ "node": "Trigger Script Factory", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "cwm": {
      "workflowKey": "script_factory",
      "version": 1,
      "purpose": "idea → script + CTA + caption + visual brief + QA",
      "tables": ["scripts", "content_ideas"]
    }
  }
}
