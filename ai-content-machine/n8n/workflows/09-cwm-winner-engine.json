{
  "name": "CWM — Winner Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "30 8 * * *" }]
        }
      },
      "id": "cron",
      "name": "Daily 08:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CWM_API_BASE}}/api/automation/trigger",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow\": \"winner_engine\",\n  \"workspaceId\": \"{{$env.CWM_DEFAULT_WORKSPACE_ID}}\",\n  \"payload\": {}\n}"
      },
      "id": "trigger",
      "name": "Trigger Winner Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Daily 08:30": {
      "main": [[{ "node": "Trigger Winner Engine", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "cwm": {
      "workflowKey": "winner_engine",
      "version": 1,
      "purpose": "Classify WINNER/PROMISING/NORMAL/LOSER and extract DNA",
      "tables": ["contents", "content_ideas", "content_metrics"]
    }
  }
}
