{
  "name": "CWM — Analytics Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 */6 * * *" }]
        }
      },
      "id": "cron",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cwm/analytics-sync",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CWM_API_BASE}}/api/analytics/sync",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const body = ($json && $json.body) ? $json.body : $json; const workspaceId = (body && body.workspaceId) || $env.CWM_DEFAULT_WORKSPACE_ID; const publicationId = body && body.publicationId; const out = { workspaceId, await: true }; if (publicationId) out.publicationId = publicationId; return out; })() }}",
        "options": { "timeout": 120000 }
      },
      "id": "sync",
      "name": "Sync Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 390]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 480]
    }
  ],
  "connections": {
    "Every 6 Hours": { "main": [[{ "node": "Sync Metrics", "type": "main", "index": 0 }]] },
    "Webhook": { "main": [[{ "node": "Sync Metrics", "type": "main", "index": 0 }]] },
    "Sync Metrics": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": {
    "cwm": {
      "workflowKey": "analytics_sync",
      "version": 2,
      "purpose": "Fetch/normalize platform metrics into metric_snapshots (MOCK deterministic)",
      "tables": ["metric_snapshots", "content_metrics"],
      "controlPlane": "/api/analytics/sync"
    }
  }
}
