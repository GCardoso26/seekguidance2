{
  "name": "tcg-judge",
  "private": true,
  "workspaces": [
    "frontend/runtime_console_v3",
    "apps/mobile",
    "apps/web"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=mobile",
    "mobile:android": "npm run android --workspace=mobile",
    "mobile:ios": "npm run ios --workspace=mobile",
    "web": "npm run dev --workspace=web",
    "web:build": "npm run build --workspace=web",
    "web:test": "npm run test --workspace=web",
    "console": "npm run dev --workspace=runtime-console-v3",
    "console:build": "npm run build --workspace=runtime-console-v3",
    "test:guard": "node testing/guards/assert-not-beta.mjs",
    "seed:local": "node testing/seed/seed-local.mjs",
    "seed:ci": "node testing/seed/seed-ci.mjs",
    "seed:demo": "node testing/seed/seed-demo.mjs",
    "seed:staging": "node testing/seed/seed-demo.mjs",
    "seed:personas": "node testing/seed/seed-personas.mjs",
    "test:personas": "node testing/seed/validate-personas.mjs",
    "test:coverage": "node testing/analytics/report-coverage.mjs",
    "test:ops-reports": "npm run test --prefix services/api -- src/catalog/providers/__tests__/opsReports.test.ts && node --experimental-strip-types testing/analytics/generate-ops-reports.mjs",
    "test:compose": "node --experimental-strip-types testing/seed/validate-compose.mjs",
    "cleanup:ci": "node testing/seed/cleanup-ci.mjs",
    "cleanup:demo": "node testing/seed/cleanup-demo.mjs",
    "test:smoke": "node testing/smoke/smoke-readonly.mjs",
    "test:audit": "node testing/audit/environment-audit.mjs",
    "test:campaign:gates": "node testing/audit/run-campaign-gates.mjs",
    "test:qa:orchestrator": "node testing/orchestrator/qa-orchestrator.mjs",
    "test:qa:trends": "node testing/orchestrator/generate-quality-trends.mjs",
    "test:infra:ci": "node testing/seed/run-ci-pipeline.mjs",
    "sync:sealed": "npm run sync:sealed --prefix services/api",
    "sync:sleeves": "npm run sync:sleeves --prefix services/api",
    "sync:deckboxes": "npm run sync:deckboxes --prefix services/api",
    "sync:binders": "npm run sync:binders --prefix services/api",
    "sync:pages": "npm run sync:pages --prefix services/api",
    "sync:dice": "npm run sync:dice --prefix services/api",
    "sync:counters": "npm run sync:counters --prefix services/api",
    "sync:playmats": "npm run sync:playmats --prefix services/api"
  },
  "devDependencies": {
    "supabase": "^2.101.0"
  }
}
