# Copiar para .env.production na EC2 (ou gerar via scripts/ec2/load_secrets.sh)
# NUNCA commitar .env.production com segredos reais.

ENVIRONMENT=production
LOG_LEVEL=INFO

# Supabase (asyncpg — API principal)
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=require

# Upstash Redis (TLS — workers arq; Judge MVP não exige fila activa)
REDIS_URL=rediss://default:TOKEN@xxxx.upstash.io:6379

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536

# Runtime pilot (obrigatório em produção)
RUNTIME_AUTH_SECRET=change-me-long-random-secret

# Persistência runtime opcional (psycopg); vazio = SQLite em /data/runtime
# Converter DATABASE_URL: postgresql+asyncpg://... -> postgresql://...
# RUNTIME_DATABASE_URL=postgresql://USER:PASSWORD@judge-tcg-db.xxxxx.us-east-1.rds.amazonaws.com:5432/tcg_judge

RUNTIME_PROMETHEUS=false
RUNTIME_OTLP=false

# AWS Secrets Manager (scripts/ec2)
# AWS_SECRET_ID=tcg-judge/production/api
# AWS_REGION=us-east-1
