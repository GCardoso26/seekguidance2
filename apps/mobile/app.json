{
  "expo": {
    "name": "Judge TCG",
    "slug": "judge-tcg",
    "scheme": "judgetcg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.judgetcg.app",
      "associatedDomains": ["applinks:judgetcg.com.br"]
    },
    "android": {
      "package": "com.judgetcg.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "judgetcg.com.br", "pathPrefix": "/judge" },
            { "scheme": "https", "host": "judgetcg.com.br", "pathPrefix": "/tournament" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#d4af37"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "judge-tcg-mobile"
      }
    }
  }
}
