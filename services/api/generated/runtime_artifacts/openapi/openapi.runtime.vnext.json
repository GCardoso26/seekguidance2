            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReplayRefBody": {
        "additionalProperties": false,
        "description": "Corpo base para opera\u00e7\u00f5es de replay.",
        "properties": {
          "replay_lineage_id": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Replay Lineage Id"
          },
          "replay_ref": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Replay Ref",
            "type": "string"
          },
          "replay_request_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
