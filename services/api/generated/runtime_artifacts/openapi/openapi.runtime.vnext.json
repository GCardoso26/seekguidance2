  "components": {
    "schemas": {
      "ChatCitation": {
        "properties": {
          "chunk_content_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunk Content Sha256"
          },
          "document_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Hash"
          },
          "document_title": {
            "title": "Document Title",
            "type": "string"
          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          },
          "page_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Number"
          },
          "retrieval_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieval Score"
          },
          "rule_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rule Path"
          },
          "section_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Path"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          },
          "version_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version Label"
          }
        },
        "required": [
          "document_title",
          "source_url",
          "excerpt"
        ],
        "title": "ChatCitation",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Data ISO (YYYY-MM-DD) para futura filtragem expl\u00edcita por vers\u00e3o.",
            "title": "As Of"
          },
          "conversation_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          },
          "explain_retrieval": {
            "default": false,
            "description": "Se true, devolve raz\u00f5es leg\u00edveis do retrieval (debug / tuning).",
            "title": "Explain Retrieval",
            "type": "boolean"
          },
          "game_slug": {
            "examples": [
              "mtg"
            ],
            "title": "Game Slug",
            "type": "string"
          },
          "include_reasoning_engine": {
            "default": false,
            "description": "Se true, executa o motor de consist\u00eancia (cadeia, conflitos, timing, valida\u00e7\u00e3o).",
            "title": "Include Reasoning Engine",
            "type": "boolean"
          },
          "mode": {
            "default": "player",
            "pattern": "^(player|judge)$",
            "title": "Mode",
            "type": "string"
          },
          "prefer_historical": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "Se true, prioriza texto indexado mais antigo e notas temporais.",
            "title": "Prefer Historical"
          },
          "question": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "game_slug",
          "question"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/ChatCitation"
            },
            "title": "Citations",
            "type": "array"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "disclaimer": {
            "title": "Disclaimer",
            "type": "string"
          },
          "explainability": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v2: retrieval_reason, reasoning_path, graph_confidence.",
            "title": "Explainability"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "reasoning_v10": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v10: semantic_memory, temporal_reasoning, semantic_lineage, ontology_evolution, drift_analytics, replay_history e bifurcation_analysis.",
            "title": "Reasoning V10"
          },
          "reasoning_v11": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v11: distributed_state, judge_session, timeline_analysis, multiplayer_resolution, tournament_operations, persistent_memory, distributed_replay, runtime_observability.",
            "title": "Reasoning V11"
          },
          "reasoning_v3": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v3: interaction_chain, conflicts_detected, timing_analysis, validation.",
            "title": "Reasoning V3"
          },
          "reasoning_v4": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v4: validated_chain, constraint_analysis, rejected_paths, propagation.",
            "title": "Reasoning V4"
          },
          "reasoning_v5": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v5: symbolic_state_transition, state_legality, structured_rules, state_graph.",
            "title": "Reasoning V5"
          },
          "reasoning_v6": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v6: causal_chain, semantic objects, layers, lineage, semantic_conflicts.",
            "title": "Reasoning V6"
          },
          "reasoning_v7": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v7: compiled_ir, runtime_execution_order, formal_mutations, deterministic_replay_hash, sandbox events, verification_results.",
            "title": "Reasoning V7"
          },
          "reasoning_v8": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v8: formal_verification, differential_analysis, replay_validation, drift_detection e fuzzing_results.",
            "title": "Reasoning V8"
          },
          "reasoning_v9": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explainability v9: semantic_compilation, ontology_analysis, ambiguity_detection, dependency_inference, semantic_graph e rule_evolution.",
            "title": "Reasoning V9"
          },
          "retrieval_reasons": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explicabilidade do retrieval (opcional; ver explain_retrieval no pedido).",
            "title": "Retrieval Reasons"
          }
        },
        "required": [
          "answer",
          "disclaimer",
          "citations",
          "confidence"
