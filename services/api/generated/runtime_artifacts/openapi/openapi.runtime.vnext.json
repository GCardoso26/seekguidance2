              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Replay Lineage Id"
          },
          "replay_ref": {
            "maxLength": 512,
            "minLength": 1,
            "title": "Replay Ref",
            "type": "string"
          },
          "replay_request_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Replay Request Id"
          }
