# Domain workers (Node) — mesmo repo/pipeline que a API Python.
# Build context: monorepo root
#   docker build -f services/api/Dockerfile.workers -t judgetcg-workers .
FROM node:20-slim AS build
WORKDIR /app
COPY services/api/package.json services/api/package-lock.json* ./
ENV REDISMS_DISABLE_POSTINSTALL=1
RUN npm install --ignore-scripts
COPY services/api/tsconfig.json services/api/vitest.config.ts ./
COPY services/api/src ./src
RUN npm run build \
  && npm prune --omit=dev \
  && mkdir -p dist/product-catalog/manufacturers \
  && find src/product-catalog/manufacturers -name 'manifest.json' -print0 \
    | while IFS= read -r -d '' f; do \
        rel="${f#src/product-catalog/manufacturers/}"; \
        dest="dist/product-catalog/manufacturers/${rel}"; \
        mkdir -p "$(dirname "$dest")"; \
        cp "$f" "$dest"; \
      done

FROM node:20-slim
WORKDIR /app
ENV NODE_ENV=production
ENV BULLMQ_WORKERS=1
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
CMD ["node", "dist/workers/main.js"]
