APP_NAME=TCG Judge API
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Deploy Render (exemplo) ---
# ENVIRONMENT=production
# DATABASE_URL=postgresql+asyncpg://user:pass@dpg-xxxx.render.com/tcg_judge
# REDIS_URL=redis://red-xxxx:6379/0
# Front Vercel: importar projeto com Root Directory = apps (ver docs/DEPLOY_RENDER_VERCEL.md)

DATABASE_URL=postgresql+asyncpg://tcgjudge:tcgjudge_dev@localhost:5432/tcg_judge
# Com docker-compose: Redis publicado em 6380 no host (6380 -> 6379 no container)
REDIS_URL=redis://localhost:6380/0

# LLM (provider-agnostic; deixe vazio no MVP local)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_EMBEDDING_MODEL=text-embedding-3-large
DEFAULT_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_DIMENSIONS=1536

OFFICIAL_SOURCES_DISCLAIMER=Informações obtidas diretamente das regras oficiais publicadas pela publisher.

# Retrieval judge-grade (denso + lexical / FTS)
RETRIEVAL_VECTOR_WEIGHT=0.65
RETRIEVAL_BM25_WEIGHT=0.35
RETRIEVAL_RRF_BLEND=0
RETRIEVAL_VECTOR_CANDIDATE_LIMIT=48
RETRIEVAL_LEXICAL_CANDIDATE_LIMIT=48
RETRIEVAL_FUSED_POOL_SIZE=72
RETRIEVAL_DIVERSIFY_SEED_CAP=16
RETRIEVAL_MAX_PER_CHAPTER=4
RETRIEVAL_MAX_PER_DOCUMENT=8
RETRIEVAL_MAX_ANCESTORS=14
RETRIEVAL_MAX_SIBLINGS_PER_SEED=5
RETRIEVAL_DEDUP_THRESHOLD=0.93
RETRIEVAL_RERANK_POOL_SIZE=28
CONFIDENCE_LOW_THRESHOLD=0.42

# Scoring composto (híbrido + temporal + rerank) e pesos temporais pós-fetch
SCORE_WEIGHT_HYBRID=1.0
SCORE_WEIGHT_TEMPORAL=0.38
SCORE_WEIGHT_RERANK=0.42
TEMPORAL_WEIGHT_VERSION_MATCH=1.0
TEMPORAL_WEIGHT_SNAPSHOT=1.0
TEMPORAL_HISTORICAL_BOOST=0.07

# Expansão por grafo de regras (vizinhança numérica + rule_graph_edges)
GRAPH_RETRIEVAL_EXTRA_LIMIT=14
GRAPH_RETRIEVAL_SCORE_BONUS=0.055
GRAPH_MAX_SEED_HEADS=14
GRAPH_EXPANSION_MIN=6
GRAPH_EXPANSION_MAX=28
# Opcional: filtrar arestas persistidas por relationship_score em metadata (ex.: 0.45)
# GRAPH_EDGE_MIN_RELATIONSHIP_SCORE=0.45

RETRIEVAL_DECOMPOSITION_EXTRA_LEXICAL=true
RETRIEVAL_DECOMPOSITION_SUBQUERY_CAP=2

# Reranker BGE (opcional; requer sentence-transformers + PyTorch)
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_BATCH_SIZE=8

# Feedback loop (tabelas retrieval_feedback + rule_graph_edge_quality)
FEEDBACK_PERSISTENCE_ENABLED=true
FEEDBACK_REINFORCEMENT_ENABLED=true

# Context assembly (prompt hierárquico + orçamento de tokens)
CONTEXT_TOKEN_BUDGET_TOTAL=7000
CONTEXT_TOKEN_BUDGET_RESERVED_ANSWER=900
CONTEXT_TOKEN_ENCODING_MODEL=cl100k_base

# Multi-TCG RAG (slugs permitidos; alinhados a `games.slug` no Postgres)
RAG_ALLOWED_GAME_SLUGS=mtg,pokemon,yugioh,onepiece,digimon,lorcana,riftbound,fab

# Observabilidade / produção
OBSERVABILITY_OTEL_ENABLED=false
OBSERVABILITY_OTEL_ENDPOINT=
OBSERVABILITY_PROMETHEUS_ENABLED=true
OBSERVABILITY_LOG_JSON=true

# API rate limit (pedidos / janela)
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60
API_RATE_LIMIT_WINDOW_SECONDS=60

# Ingestão (workers / crawlers)
INGESTION_DEFAULT_HOST_RPS=1.0
INGESTION_MAX_CONCURRENT_DOWNLOADS=4
INGESTION_DLQ_ENABLED=true

# Cache (TTL segundos; implementação Redis futura)
CACHE_RETRIEVAL_TTL_SECONDS=300
CACHE_SEMANTIC_TTL_SECONDS=600

# SLO (ms / score 0–1)
SLO_RETRIEVAL_P95_MS_TARGET=800
SLO_REASONING_P95_MS_TARGET=1500
SLO_REPLAY_DETERMINISM_MIN_SCORE=0.95

# Correctness formal (solver stub; Z3/PySMT futuros via mesmo contrato)
FORMAL_SOLVER_BACKEND=stub
FORMAL_SOLVER_TIMEOUT_MS=2000
CORPUS_TRUST_FLOOR=0.35
CONTINUOUS_EVAL_NIGHTLY=false

# Chaves opcionais formal_proofs em reasoning_v8–v11 (additive; default off)
REASONING_FORMAL_EXPLAINABILITY_ENABLED=false

# Observabilidade / tracing (sampling 0–1)
# OBSERVABILITY_TRACE_SAMPLE_RATE=0.1

# DLQ workers (prefixo Redis)
# WORKER_DLQ_REDIS_KEY_PREFIX=tcg:dlq

# Anti-explosão de grafo (entropia / pruning)
# GRAPH_EXPLOSION_ENTROPY_PRUNE_THRESHOLD=0.82

# Assinatura HMAC de payloads de replay (opcional)
# REPLAY_SIGNING_SECRET=
