{
  "name": "@judgetcg/domain-workers",
  "version": "0.1.0",
  "private": true,
  "description": "JudgeTCG domain workers (BullMQ) + catalog/pricing/media platform — same package as FastAPI API",
  "type": "module",
  "main": "dist/workers/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/workers/main.ts",
    "worker": "node dist/workers/main.js",
    "worker:outbox": "node dist/workers/outbox-publisher.js",
    "worker:search": "tsx src/workers/search-worker.ts",
    "report:search": "tsx src/workers/search-report.ts",
    "api:public": "tsx src/workers/public-api.ts",
    "api:marketplace": "tsx src/workers/marketplace-api.ts",
    "api:auth": "tsx src/workers/auth-api.ts",
    "smoke:golden-path": "tsx src/workers/smoke-golden-path.ts",
    "smoke:periodic": "tsx src/workers/smoke-periodic.ts",
    "smoke:production-readiness": "tsx src/workers/smoke-production-readiness.ts",
    "integration:up": "docker compose -f infra/integration/docker-compose.yml up -d",
    "integration:down": "docker compose -f infra/integration/docker-compose.yml down",
    "test": "vitest run",
    "test:chaos": "vitest run src/ops/__tests__/chaos.light.test.ts src/ops/chaos",
    "test:budget": "vitest run src/ops/__tests__/performanceBudget.test.ts",
    "test:watch": "vitest",
    "test:contracts": "vitest run src/catalog/persistence/__contracts__",
    "certify:db": "tsx src/platform/db/runDatabaseCertification.ts",
    "certify:order": "tsx src/order/runOrderCertification.ts",
    "certify:checkout": "tsx src/order/runCheckoutCertification.ts",
    "certify:checkout:prod": "tsx scripts/certify-checkout-production.ts",
    "certify:payment": "tsx src/payment/runPaymentCertification.ts",
    "certify:bullmq": "tsx scripts/certify-bullmq.ts",
    "load:probe": "tsx scripts/load-probe-v6.ts",
    "test:order:contracts": "vitest run src/order/persistence/__contracts__",
    "test:order:reservation": "vitest run src/order/reservation/__tests__",
    "test:checkout:e2e": "vitest run src/order/__tests__/checkout.api.e2e.test.ts",
    "test:payment": "vitest run src/payment",
    "api:checkout": "tsx src/workers/checkout-api.ts",
    "api:checkout-v2": "tsx src/workers/checkout-v2-api.ts",
    "sync:scryfall:shadow": "tsx src/workers/scryfall-shadow.ts",
    "sync:lorcana:seed": "tsx src/workers/lorcana-seed.ts",
    "sync:sealed": "tsx src/product-catalog/workers/sync-runner.ts catalog.sync.sealed",
    "sync:sleeves": "tsx src/product-catalog/workers/sync-runner.ts catalog.sync.sleeves",
    "sync:deckboxes": "tsx src/product-catalog/workers/sync-runner.ts catalog.sync.deckboxes",
    "sync:binders": "tsx src/product-catalog/workers/sync-runner.ts catalog.sync.binders",
    "sync:pages": "tsx src/product-catalog/workers/sync-runner.ts catalog.sync.pages",
    "sync:dice": "tsx src/product-catalog/workers/sync-runner.ts catalog.sync.dice",
    "sync:counters": "tsx src/product-catalog/workers/sync-runner.ts catalog.sync.counters",
    "sync:playmats": "tsx src/product-catalog/workers/sync-runner.ts catalog.sync.playmats",
    "pricing:sync": "tsx src/pricing/workers/pricing-sync.ts",
    "scheduler:tick": "tsx src/product-catalog/workers/scheduler-tick.ts",
    "catalog:remediate-p0": "tsx src/product-catalog/workers/remediate-p0-catalog.ts",
    "marketplace:publish-product": "tsx src/marketplace/workers/publish-product-listing.ts",
    "checkout:start": "tsx src/checkout/workers/start-checkout.ts",
    "smoke:rapunzel": "tsx src/workers/smoke-rapunzel.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "redis-memory-server": "^0.12.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
