{
  "uid": "judgetcg-platform",
  "title": "JudgeTCG — Plataforma",
  "tags": ["judgetcg", "sprint6"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests/sec",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(http_requests_total[1m])", "legendFormat": "rps" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "rate(http_errors_total[5m])", "legendFormat": "errors" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency (duration)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(http_request_duration_seconds_sum[5m]) / rate(http_request_duration_seconds_count[5m])", "legendFormat": "avg" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Availability (ready)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "up", "legendFormat": "up" }]
    }
  ]
}
