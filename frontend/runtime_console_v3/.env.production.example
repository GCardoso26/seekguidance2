# Template Vercel / produção — NÃO commitar secrets reais.
# Variáveis de backend (DATABASE_URL, REDIS_URL, OPENAI_API_KEY) vão no Render/API, não aqui.

# NEXT_PUBLIC_* é exposto no bundle: use APENAS a chave anon (role=anon no JWT).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Runtime Console
NEXT_PUBLIC_APP_URL=https://judgetcg.com.br

# Supabase → Project Settings → API → anon / public key (NUNCA service_role)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_ANON_JWT_WITH_ROLE_ANON

# Servidor Next.js → API FastAPI (Render)
API_PROXY_TARGET=https://your-api.onrender.com
