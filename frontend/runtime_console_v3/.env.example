# Copie para .env.local — NÃO commitar secrets reais.
# NEXT_PUBLIC_* é exposto no bundle do browser: use APENAS a chave anon (role=anon).

# Deixe vazio na EC2 (usa /api/proxy → API local). No PC apontando à EC2:
# NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_NAME=Runtime Console
# Produção: https://judgetcg.com.br | Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://judgetcg.com.br

# Transparência legal BP 5.2 — obrigatórias em produção (gate brandHasLegalTransparency).
# Precisam estar no host do Next.js e exigir REDEPLOY após setar.
# NEXT_PUBLIC_LEGAL_NAME=RAZAO SOCIAL LTDA
# NEXT_PUBLIC_CNPJ=00.000.000/0000-00
# NEXT_PUBLIC_LEGAL_ADDRESS=Rua X, 123, Bairro, Cidade - UF, CEP 00000-000
# NEXT_PUBLIC_SUPPORT_EMAIL=suporte@judgetcg.com.br

# Server-only (NÃO usar NEXT_PUBLIC_ — não expor no bundle)
# RUNTIME_AUTH_SECRET=... (mesmo valor do FastAPI — verificação admin no middleware)
# SUPABASE_JWT_SECRET=... (Dashboard → Settings → API → JWT Secret)
# PLAN_LIMIT_SECRET=... (openssl rand -base64 48 — cookie limite diário Judge)
# SUPABASE_SERVICE_ROLE_KEY=... (E2E Playwright, badges, moderação — NUNCA no browser)
# JUDGE_ADMIN_EMAILS=admin@judgetcg.com.br
# JUDGE_PANEL_EMAILS=judge@judgetcg.com.br
# STRIPE_SECRET_KEY=sk_test_...
# RUNTIME_DEFAULT_ADMIN_PASSWORD=admin

# Supabase Auth (opcional — sem estas vars usa só localStorage)
# Dashboard → Auth → URL Configuration:
#   Site URL: https://judgetcg.com.br
#   Redirect URLs (incluir query params — use wildcard):
#   https://judgetcg.com.br/auth/callback**
#   http://localhost:3000/auth/callback**
# Dashboard → Project Settings → API → "anon" / "public" key (NUNCA service_role)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_ANON_JWT_WITH_ROLE_ANON

# Stripe (test mode — chave publishable apenas no frontend)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_SPIKE=price_...
# NEXT_PUBLIC_STRIPE_PRICE_ANNUAL_SPIKE=price_...
# NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_TEAM=price_...
# NEXT_PUBLIC_STRIPE_PRICE_ANNUAL_TEAM=price_...
# NEXT_PUBLIC_STRIPE_PRICE_ANNUAL_SPIKE=price_...
# NEXT_PUBLIC_STRIPE_PRICE_MONTHLY_TEAM=price_...
# NEXT_PUBLIC_STRIPE_PRICE_ANNUAL_TEAM=price_...

# API (servidor Next → FastAPI)
# Produção Render atual (serviço recriado):
API_PROXY_TARGET=https://seekguidance2-0iw4.onrender.com

# Checkout BC V2 — Node API (NÃO use seekguidance.onrender.com)
# Local: npm run api:checkout-v2 em services/api (porta 8791)
# NEXT_PUBLIC_CHECKOUT_V2=1
# CHECKOUT_V2_API_URL=http://127.0.0.1:8791

# Monitoramento (opcional)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=... (CI — source maps)
# SENTRY_ORG=judgetcg
# SENTRY_PROJECT=judgetcg-web

# Upstash Redis — rate limit distribuído + cache de busca (Vercel)
# Criar em https://console.upstash.com → REST API
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Crons Vercel (Authorization: Bearer CRON_SECRET)
# CRON_SECRET=gerar-string-aleatoria-longa

# E2E Playwright (e2e/auth.setup.ts) — local/CI com Supabase de teste
# BASE_URL=http://localhost:3000
# Requer também NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY

# APIs de pricing externas (valuation engine)
# TCG_API_KEY=...
# CARDMARKET_API_KEY=...
# EXCHANGE_RATE_API_KEY=...

# Marketplace checkout (obrigatório para pagamentos de produtos)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
