# Template — migração Supabase (não commitar valores reais)
# Copiar para .env.production ou secrets do host da API (Render/Fly)

# Supabase Postgres (Session pooler — FastAPI asyncpg)
# Dashboard → Settings → Database → Connection string → URI
# Trocar postgresql:// por postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Opcional: mesmo DB, URL directa só para migrations/pg_dump (porta 5432 db.*.supabase.co)
# DATABASE_URL_DIRECT=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Redis (Upstash — workers; Judge MVP pode usar instância mínima)
REDIS_URL=rediss://default:TOKEN@REGION.upstash.io:6379

OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1536

RUNTIME_AUTH_SECRET=gerar-valor-longo-aleatorio
ENVIRONMENT=production

# Runtime pilot: vazio = SQLite no volume do container API
# RUNTIME_DATABASE_URL=

# Frontend Vercel (não usar na API)
# NEXT_PUBLIC_APP_URL=https://judgetcg.com.br
# API_PROXY_TARGET=https://sua-api.onrender.com
